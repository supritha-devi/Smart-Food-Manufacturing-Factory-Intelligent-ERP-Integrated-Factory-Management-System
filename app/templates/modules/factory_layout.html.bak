{% extends 'base.html' %}
{% block title %}Smart Food Manufacturing Factory - Factory Layout{% endblock %}
{% block content %}
<div class="page-heading factory-page-heading">
  <div><p class="eyebrow">Factory Layout - Interactive 2D Map</p><h1>Smart Food Manufacturing Factory</h1></div>
  <div class="d-flex gap-2 align-items-center flex-wrap">
    <a class="btn btn-primary" href="{{ url_for('voice.record') }}">Record Factory Voice</a>
    <span class="layout-status"><span class="status-dot"></span> Factory Status: Operational</span>
  </div>
</div>

<div class="factory-layout-shell reference-layout">
  <div class="factory-map reference-map" id="factoryMap">
    <svg viewBox="0 0 1100 650" role="img" aria-label="Interactive top view map of Smart Food Manufacturing Factory">
      <defs>
        <pattern id="smallGrid" width="16" height="16" patternUnits="userSpaceOnUse">
          <path d="M16 0H0V16" fill="none" stroke="#DDE6EC" stroke-width="1"/>
        </pattern>
        <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
          <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#795548" flood-opacity=".18"/>
        </filter>
      </defs>

      <rect width="1100" height="650" fill="#FFF9F5"/>
      <rect x="28" y="22" width="1044" height="596" rx="12" fill="#F6E9DF" stroke="#795548" stroke-width="4"/>

      <!-- External road and compound fence -->
      <rect x="28" y="22" width="1044" height="38" fill="#EADDD5"/>
      <rect x="28" y="580" width="1044" height="38" fill="#EADDD5"/>
      <rect x="28" y="22" width="38" height="596" fill="#EADDD5"/>
      <rect x="1034" y="22" width="38" height="596" fill="#EADDD5"/>
      <g fill="#795548">
        <rect x="50" y="30" width="1000" height="4" rx="2"/>
        <rect x="50" y="586" width="1000" height="4" rx="2"/>
        <rect x="36" y="58" width="4" height="514"/>
        <rect x="1060" y="58" width="4" height="514"/>
      </g>
      <g fill="#CBE4B5" stroke="#77A85A" stroke-width="2">
        <circle cx="52" cy="38" r="13"/><circle cx="92" cy="38" r="13"/><circle cx="132" cy="38" r="13"/>
        <circle cx="172" cy="38" r="13"/><circle cx="212" cy="38" r="13"/><circle cx="252" cy="38" r="13"/>
        <circle cx="292" cy="38" r="13"/><circle cx="332" cy="38" r="13"/><circle cx="372" cy="38" r="13"/>
        <circle cx="412" cy="38" r="13"/><circle cx="452" cy="38" r="13"/><circle cx="492" cy="38" r="13"/>
        <circle cx="532" cy="38" r="13"/><circle cx="572" cy="38" r="13"/><circle cx="612" cy="38" r="13"/>
        <circle cx="652" cy="38" r="13"/><circle cx="692" cy="38" r="13"/><circle cx="732" cy="38" r="13"/>
        <circle cx="772" cy="38" r="13"/><circle cx="812" cy="38" r="13"/><circle cx="852" cy="38" r="13"/>
        <circle cx="892" cy="38" r="13"/><circle cx="932" cy="38" r="13"/><circle cx="972" cy="38" r="13"/>
        <circle cx="1012" cy="38" r="13"/>
      </g>

      <!-- Internal roads -->
      <rect x="66" y="64" width="968" height="70" fill="#FFFDFC" stroke="#E3D3C7" stroke-width="2"/>
      <rect x="66" y="143" width="968" height="20" fill="#EADFD5"/>
      <rect x="66" y="310" width="968" height="20" fill="#EADFD5"/>
      <rect x="66" y="475" width="968" height="20" fill="#EADFD5"/>
      <rect x="66" y="504" width="968" height="68" fill="#FFFDFC" stroke="#E3D3C7" stroke-width="2"/>

      <!-- Raw Material Warehouse -->
      <g class="zone map-zone" tabindex="0" role="button" data-name="Raw Material Warehouse" data-status="Active" data-detail="Raw material storage and issue area">
        <rect x="66" y="64" width="230" height="70" rx="8" fill="#FBE8EC" stroke="#B77950" stroke-width="3" filter="url(#shadow)"/>
        <rect x="78" y="76" width="74" height="46" rx="3" fill="#F2E2D7"/>
        <g fill="#F7E3C1" stroke="#B77950"><rect x="82" y="82" width="18" height="34" rx="2"/><rect x="104" y="82" width="18" height="34" rx="2"/><rect x="126" y="82" width="18" height="34" rx="2"/></g>
        <circle cx="177" cy="92" r="8" fill="#7B543E"/><rect x="166" y="98" width="22" height="14" rx="3" fill="#E4A23A"/>
        <rect x="158" y="70" width="126" height="58" rx="6" fill="#FFFFFF" stroke="#D4DEE7"/>
        <text x="221" y="90" text-anchor="middle" font-size="13" fill="#49352D" font-weight="700">Raw Material</text>
        <text x="221" y="107" text-anchor="middle" font-size="13" fill="#17365D" font-weight="700">Warehouse</text>
        <circle cx="221" cy="119" r="5" fill="#2F9E44"/><text x="230" y="123" font-size="10" fill="#17365D">Active</text>
      </g>

      <!-- Packaging Warehouse -->
      <g class="zone map-zone" tabindex="0" role="button" data-name="Packaging Warehouse" data-status="Active" data-detail="Pouches, cartons, labels and packaging storage">
        <rect x="804" y="64" width="230" height="70" rx="8" fill="#FBE8EC" stroke="#B77950" stroke-width="3" filter="url(#shadow)"/>
        <rect x="816" y="76" width="74" height="46" rx="3" fill="#F2E2D7"/>
        <g fill="#C67F43"><rect x="823" y="82" width="17" height="34"/><rect x="844" y="82" width="17" height="34"/><rect x="865" y="82" width="17" height="34"/></g>
        <rect x="892" y="70" width="128" height="58" rx="6" fill="#FFFFFF" stroke="#D4DEE7"/>
        <text x="956" y="90" text-anchor="middle" font-size="13" fill="#17365D" font-weight="700">Packaging Material</text>
        <text x="956" y="107" text-anchor="middle" font-size="13" fill="#17365D" font-weight="700">Warehouse</text>
        <circle cx="956" cy="119" r="5" fill="#2F9E44"/><text x="965" y="123" font-size="10" fill="#17365D">Active</text>
      </g>

      <!-- Production zones -->
      <g class="zone map-zone" tabindex="0" role="button" data-name="Murukku Production" data-status="Active" data-detail="Dough, shaping, frying and cooling">
        <rect x="66" y="174" width="190" height="118" rx="9" fill="#FFF7E8" stroke="#B77950" stroke-width="3" filter="url(#shadow)"/>
        <rect x="78" y="188" width="60" height="82" rx="4" fill="#F2D4A5"/>
        <circle cx="108" cy="214" r="19" fill="#EFAE32" stroke="#B77950" stroke-width="3"/><circle cx="108" cy="214" r="8" fill="#FFF1C7"/>
        <rect x="138" y="188" width="106" height="82" rx="5" fill="#FFFFFF"/>
        <text x="191" y="219" text-anchor="middle" font-size="15" fill="#49352D" font-weight="700">Murukku</text>
        <text x="191" y="237" text-anchor="middle" font-size="15" fill="#49352D" font-weight="700">Production</text>
        <circle cx="191" cy="254" r="5" fill="#5F8F72"/><text x="200" y="258" font-size="10" fill="#49352D">Active</text>
      </g>

      <g class="zone map-zone" tabindex="0" role="button" data-name="Potato Chips Production" data-status="Active" data-detail="Washing, peeling, slicing and frying">
        <rect x="270" y="174" width="190" height="118" rx="9" fill="#FFF9E5" stroke="#B77950" stroke-width="3" filter="url(#shadow)"/>
        <rect x="282" y="188" width="60" height="82" rx="4" fill="#DDE9C7"/>
        <g fill="#F3C75A" stroke="#D49A31"><ellipse cx="309" cy="212" rx="15" ry="8"/><ellipse cx="316" cy="226" rx="15" ry="8"/><ellipse cx="302" cy="240" rx="15" ry="8"/></g>
        <rect x="342" y="188" width="106" height="82" rx="5" fill="#FFFFFF"/>
        <text x="395" y="219" text-anchor="middle" font-size="15" fill="#49352D" font-weight="700">Potato Chips</text>
        <text x="395" y="237" text-anchor="middle" font-size="15" fill="#49352D" font-weight="700">Production</text>
        <circle cx="395" cy="254" r="5" fill="#5F8F72"/><text x="404" y="258" font-size="10" fill="#49352D">Active</text>
      </g>

      <g class="zone map-zone" tabindex="0" role="button" data-name="Banana Chips Production" data-status="Active" data-detail="Peeling, slicing, frying and de-oiling">
        <rect x="474" y="174" width="190" height="118" rx="9" fill="#FFF7E8" stroke="#9B6FB1" stroke-width="3" filter="url(#shadow)"/>
        <rect x="486" y="188" width="60" height="82" rx="4" fill="#EBDDF2"/>
        <g fill="#F1D06A" stroke="#C59A32"><ellipse cx="514" cy="210" rx="14" ry="7"/><ellipse cx="526" cy="224" rx="14" ry="7"/><ellipse cx="504" cy="238" rx="14" ry="7"/></g>
        <rect x="546" y="188" width="106" height="82" rx="5" fill="#FFFFFF"/>
        <text x="599" y="219" text-anchor="middle" font-size="15" fill="#49352D" font-weight="700">Banana Chips</text>
        <text x="599" y="237" text-anchor="middle" font-size="15" fill="#49352D" font-weight="700">Production</text>
        <circle cx="599" cy="254" r="5" fill="#5F8F72"/><text x="608" y="258" font-size="10" fill="#49352D">Active</text>
      </g>

      <g class="zone map-zone" tabindex="0" role="button" data-name="Mixture Production" data-status="Active" data-detail="Ingredient mixing, frying and seasoning">
        <rect x="270" y="340" width="190" height="118" rx="9" fill="#FFF0F2" stroke="#D48891" stroke-width="3" filter="url(#shadow)"/>
        <rect x="282" y="354" width="60" height="82" rx="4" fill="#F3CDB7"/>
        <g fill="#D76B55"><circle cx="302" cy="380" r="7"/><circle cx="322" cy="373" r="7"/><circle cx="313" cy="401" r="7"/></g>
        <rect x="342" y="354" width="106" height="82" rx="5" fill="#FFFFFF"/>
        <text x="395" y="385" text-anchor="middle" font-size="15" fill="#49352D" font-weight="700">Mixture</text>
        <text x="395" y="403" text-anchor="middle" font-size="15" fill="#49352D" font-weight="700">Production</text>
        <circle cx="395" cy="420" r="5" fill="#5F8F72"/><text x="404" y="424" font-size="10" fill="#49352D">Active</text>
      </g>

      <g class="zone map-zone" tabindex="0" role="button" data-name="Mysore Pak Production" data-status="Active" data-detail="Cooking, cooling, cutting and packaging">
        <rect x="474" y="340" width="190" height="118" rx="9" fill="#FFF5E5" stroke="#B77950" stroke-width="3" filter="url(#shadow)"/>
        <rect x="486" y="354" width="60" height="82" rx="4" fill="#EFD49D"/>
        <g fill="#E7A927" stroke="#B77950"><rect x="494" y="368" width="44" height="14" rx="2"/><rect x="494" y="386" width="44" height="14" rx="2"/><rect x="494" y="404" width="44" height="14" rx="2"/></g>
        <rect x="546" y="354" width="106" height="82" rx="5" fill="#FFFFFF"/>
        <text x="599" y="385" text-anchor="middle" font-size="13" fill="#49352D" font-weight="700">Mysore Pak</text>
        <text x="599" y="403" text-anchor="middle" font-size="13" fill="#49352D" font-weight="700">Production</text>
        <circle cx="599" cy="420" r="5" fill="#5F8F72"/><text x="608" y="424" font-size="9" fill="#49352D">Active</text>
      </g>

      <!-- Quality and support areas -->
      <g class="zone map-zone" tabindex="0" role="button" data-name="Quality Control" data-status="Active" data-detail="Incoming and finished goods inspection">
        <rect x="678" y="340" width="190" height="118" rx="9" fill="#E8F3FA" stroke="#4F95B8" stroke-width="3" filter="url(#shadow)"/>
        <rect x="690" y="354" width="166" height="90" rx="5" fill="#FFFFFF"/>
        <circle cx="716" cy="388" r="18" fill="#D8EDF6" stroke="#4F95B8"/><path d="M708 388l6 6 12-14" fill="none" stroke="#2F9E44" stroke-width="4"/>
        <text x="778" y="392" text-anchor="middle" font-size="15" fill="#17365D" font-weight="700">Quality Control</text>
        <circle cx="778" cy="420" r="5" fill="#2F9E44"/><text x="787" y="424" font-size="10" fill="#17365D">Active</text>
      </g>

      <g class="zone map-zone" tabindex="0" role="button" data-name="Finished Goods Warehouse" data-status="Active" data-detail="Released finished goods inventory">
        <rect x="66" y="504" width="390" height="68" rx="9" fill="#DFF2DD" stroke="#4D9061" stroke-width="3" filter="url(#shadow)"/>
        <g fill="#D8A55A" stroke="#8F6836"><rect x="82" y="516" width="30" height="42" rx="3"/><rect x="118" y="516" width="30" height="42" rx="3"/></g>
        <rect x="166" y="514" width="278" height="48" rx="5" fill="#FFFFFF"/>
        <text x="305" y="536" text-anchor="middle" font-size="15" fill="#17365D" font-weight="700">Finished Goods Warehouse</text>
        <circle cx="305" cy="553" r="5" fill="#2F9E44"/><text x="314" y="557" font-size="10" fill="#17365D">Active</text>
      </g>

      <g class="zone map-zone" tabindex="0" role="button" data-name="Dispatch" data-status="Active" data-detail="Vehicle loading and dispatch staging">
        <rect x="478" y="504" width="230" height="68" rx="9" fill="#DCDDF6" stroke="#7779B5" stroke-width="3" filter="url(#shadow)"/>
        <rect x="490" y="514" width="206" height="48" rx="5" fill="#FFFFFF"/>
        <rect x="510" y="527" width="48" height="23" rx="4" fill="#F1A44A"/><rect x="558" y="535" width="20" height="15" fill="#F1A44A"/>
        <text x="632" y="536" text-anchor="middle" font-size="14" fill="#17365D" font-weight="700">Dispatch Section</text>
        <circle cx="632" cy="553" r="5" fill="#2F9E44"/><text x="641" y="557" font-size="10" fill="#17365D">Active</text>
      </g>

      <g class="zone map-zone" tabindex="0" role="button" data-name="Administration" data-status="Active" data-detail="Office and factory administration">
        <rect x="722" y="504" width="312" height="68" rx="9" fill="#EDF1F7" stroke="#7E94A9" stroke-width="3" filter="url(#shadow)"/>
        <rect x="734" y="514" width="288" height="48" rx="5" fill="#FFFFFF"/>
        <circle cx="770" cy="537" r="12" fill="#88A9CA"/><rect x="758" y="549" width="24" height="8" rx="4" fill="#88A9CA"/>
        <text x="903" y="536" text-anchor="middle" font-size="14" fill="#17365D" font-weight="700">Office &amp; Administration</text>
        <circle cx="903" cy="553" r="5" fill="#2F9E44"/><text x="912" y="557" font-size="10" fill="#17365D">Active</text>
      </g>

      <!-- Central green support strip -->
      <rect x="66" y="340" width="390" height="118" rx="9" fill="#F8FAFC" stroke="#A7BAC9" stroke-width="3"/>
      <rect x="78" y="352" width="366" height="94" rx="6" fill="#EEF4F7"/>
      <text x="261" y="405" text-anchor="middle" font-size="16" fill="#71839A" font-weight="700">Production Support Corridor</text>

      <!-- Road lane markings and loading vehicles -->
      <g stroke="#FFFFFF" stroke-width="3" stroke-dasharray="18 14">
        <path d="M548 64V572"/><path d="M104 572V504"/><path d="M1000 572V504"/>
      </g>
      <g>
        <rect x="470" y="548" width="42" height="24" rx="5" fill="#F2A23A" stroke="#17365D"/>
        <rect x="512" y="553" width="14" height="19" rx="3" fill="#F2A23A"/>
        <circle cx="478" cy="572" r="5" fill="#17365D"/><circle cx="506" cy="572" r="5" fill="#17365D"/>
        <rect x="618" y="490" width="38" height="22" rx="5" fill="#205A96" stroke="#17365D"/>
        <circle cx="626" cy="512" r="5" fill="#17365D"/><circle cx="648" cy="512" r="5" fill="#17365D"/>
      </g>

      <!-- Trees and compound details -->
      <g fill="#82B35E" stroke="#5F9148" stroke-width="2">
        <circle cx="52" cy="128" r="16"/><circle cx="52" cy="272" r="16"/><circle cx="52" cy="414" r="16"/>
        <circle cx="1048" cy="128" r="16"/><circle cx="1048" cy="272" r="16"/><circle cx="1048" cy="414" r="16"/>
        <circle cx="80" cy="608" r="13"/><circle cx="180" cy="608" r="13"/><circle cx="280" cy="608" r="13"/>
        <circle cx="380" cy="608" r="13"/><circle cx="480" cy="608" r="13"/><circle cx="580" cy="608" r="13"/>
        <circle cx="680" cy="608" r="13"/><circle cx="780" cy="608" r="13"/><circle cx="880" cy="608" r="13"/>
        <circle cx="980" cy="608" r="13"/>
      </g>
    </svg>
  </div>

  <aside class="factory-info reference-info">
    <p class="eyebrow">Factory Information</p>
    <h2 id="factoryInfoName">Smart Food Manufacturing Factory</h2>
    <p class="factory-tagline">Quality Snacks - Healthy Tomorrow</p>
    <span class="status active" id="factoryInfoStatus">Factory Operational</span>
    <p id="factoryInfoDetail">Select a department to view its details.</p>

    <div class="factory-summary">
      <h3>Departments Summary</h3>
      <div class="summary-row"><span><i class="summary-dot production"></i>Production Sections</span><strong>{{ summary.production }}</strong></div>
      <div class="summary-row"><span><i class="summary-dot warehouse"></i>Warehouses</span><strong>{{ summary.warehouses }}</strong></div>
      <div class="summary-row"><span><i class="summary-dot quality"></i>Quality Control</span><strong>1</strong></div>
      <div class="summary-row"><span><i class="summary-dot dispatch"></i>Dispatch</span><strong>1</strong></div>
      <div class="summary-row"><span><i class="summary-dot admin"></i>Administration</span><strong>1</strong></div>
    </div>

    <div class="quick-actions">
      <h3>Quick Actions</h3>
      <a href="{{ url_for('modules.factory_layout') }}">View All Departments</a>
      {% if 'OWNER' in session.roles %}<a href="{{ url_for('modules.initialization_wizard') }}">Manage Factory</a>{% endif %}
      <a href="{{ url_for('modules.reports_dashboard') }}">View Reports</a>
    </div>
  </aside>
</div>

<div class="layout-kpi-strip">
  <div><span class="kpi-symbol blue">11</span><div><strong>{{ summary.total }}</strong><small>Total Departments</small></div></div>
  <div><span class="kpi-symbol green">5</span><div><strong>{{ summary.production }}</strong><small>Production Sections</small></div></div>
  <div><span class="kpi-symbol orange">3</span><div><strong>{{ summary.warehouses }}</strong><small>Warehouses</small></div></div>
  <div><span class="kpi-symbol teal">9</span><div><strong>{{ summary.active }}</strong><small>Active</small></div></div>
  <div><span class="kpi-symbol pink">1</span><div><strong>{{ summary.inactive }}</strong><small>Inactive</small></div></div>
</div>

<script>
window.factoryDepartmentRoutes = {
  {% for department in departments %}"{{ department.name|e }}": "{{ url_for('modules.department_detail', department_id=department.id) }}"{% if not loop.last %},{% endif %}{% endfor %}
};
</script>
{% endblock %}
